LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DASHSCOPE_API_KEY=
IMAGE_API_PROVIDER=dashscope
IMAGE_MODEL=
IMAGE_SIZE=1696*960
IMAGE_API_BASE_URL=
LLM_IMAGE_PROMPT_MODEL=
JAMENDO_CLIENT_ID=
AUDIO_ANALYSIS_URL=http://127.0.0.1:8001
# Production uses vercel-python. Local development leaves these empty and proxies to AUDIO_ANALYSIS_URL.
AUDIO_ANALYSIS_PROVIDER=
NEXT_PUBLIC_AUDIO_ANALYSIS_PROVIDER=
# Optional external analyzer URL retained for self-hosted deployments.
NEXT_PUBLIC_AUDIO_ANALYSIS_URL=
# Online persistence. Use the Supavisor transaction-pooler connection string.
DATABASE_PROVIDER=sqlite
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GENERATED_BUCKET=generated
SUPABASE_AUDIO_BUCKET=audio-analysis
# Required for /api/experiment/export. Send as Authorization: Bearer <token>.
EXPERIMENT_EXPORT_TOKEN=
# Local-only research dashboard. Keep disabled on public deployments.
RESEARCH_DASHBOARD_ENABLED=false
