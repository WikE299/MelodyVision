LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DASHSCOPE_API_KEY=
IMAGE_API_PROVIDER=dashscope
IMAGE_MODEL=
IMAGE_SIZE=1696*960
IMAGE_API_BASE_URL=
LLM_IMAGE_PROMPT_MODEL=
JAMENDO_CLIENT_ID=

# Server-only key for Seed Audio 1.0 image-conditioned audio generation.
# Never prefix this variable with NEXT_PUBLIC_.
SEED_AUDIO_API_KEY=
# Vision model used to translate artwork into a text-only music brief.
VISUAL_MUSIC_MODEL=qwen3.8-flash
# Enables the standalone Audio Lab. Defaults to true locally and false in production.
AUDIO_LAB_ENABLED=
AUDIO_ANALYSIS_URL=http://127.0.0.1:8001
# Production uses vercel-python. Local development leaves these empty and proxies to AUDIO_ANALYSIS_URL.
AUDIO_ANALYSIS_PROVIDER=
NEXT_PUBLIC_AUDIO_ANALYSIS_PROVIDER=
# Optional external analyzer URL retained for self-hosted deployments.
NEXT_PUBLIC_AUDIO_ANALYSIS_URL=
# Online persistence. Use the Supavisor transaction-pooler connection string.
DATABASE_PROVIDER=sqlite
SUPABASE_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GENERATED_BUCKET=generated
SUPABASE_AUDIO_BUCKET=audio-analysis
# Private bucket used to retain Audio Lab generations before provider URLs expire.
SUPABASE_AUDIO_LAB_BUCKET=audio-lab
# Required for /api/experiment/export. Send as Authorization: Bearer <token>.
EXPERIMENT_EXPORT_TOKEN=
# Local-only research dashboard. Keep disabled on public deployments.
RESEARCH_DASHBOARD_ENABLED=false
# Local-only questionnaire component lab. Keep disabled on public deployments.
QUESTIONNAIRE_LAB_ENABLED=false
# Optional local dashboard sync from the protected production export endpoint.
RESEARCH_REMOTE_EXPORT_URL=
RESEARCH_REMOTE_EXPORT_TOKEN=
# Optional direct production Supabase reader when the Vercel alias is unavailable.
RESEARCH_SUPABASE_URL=
RESEARCH_SUPABASE_SERVICE_ROLE_KEY=
# Additional HTTPS hosts allowed by the local thumbnail proxy, comma-separated.
RESEARCH_IMAGE_HOSTS=
